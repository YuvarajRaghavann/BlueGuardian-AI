PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/blueguardian
# For `npm run test:recovery:mongo` only: point to a disposable local database named exactly blueguardian_test.
# Never use a production or shared database for this destructive integration suite.
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/blueguardian_test
BLUEGUARDIAN_AUTH_MODE=required
BLUEGUARDIAN_OWNER_ID=replace-with-server-configured-owner-subject
BLUEGUARDIAN_OWNER_TOKEN=replace-with-secret-managed-owner-token
# Reserved for a future constrained participant flow; no current recovery route accepts it.
BLUEGUARDIAN_PARTICIPANT_TOKEN=


# ============================================================
# BlueGuardian AI - Backend Environment Configuration
# ============================================================

# -------------------- Server --------------------
PORT=4000

# -------------------- Main Database --------------------
# Local development database.
# For MongoDB Atlas, use your actual URI in backend/.env,
# NEVER put credentials in this example file.
MONGODB_URI=mongodb://127.0.0.1:27017/blueguardian

# -------------------- Browser CORS --------------------
# Exact frontend origins, comma-separated.
# Leave empty when using the Vite development proxy.
# For deployment, replace with your real frontend origin(s).
# Example format:
# BLUEGUARDIAN_CORS_ORIGINS=https://your-frontend.example
BLUEGUARDIAN_CORS_ORIGINS=

# -------------------- Authentication --------------------
# Authentication is required for protected API routes.
BLUEGUARDIAN_AUTH_MODE=required

# Development owner identity.
# Replace these placeholder values in your local backend/.env.
BLUEGUARDIAN_OWNER_ID=replace-with-server-configured-owner-id
BLUEGUARDIAN_OWNER_TOKEN=replace-with-a-long-random-secret

# Reserved for future community-participant authentication.
# No complete community-reporting workflow is enabled yet.
BLUEGUARDIAN_PARTICIPANT_TOKEN=

# -------------------- MongoDB Integration Tests --------------------
# ONLY use a disposable LOCAL test database named exactly:
# blueguardian_test
#
# The guarded runner refuses remote databases and other database names.
# Configure this value in your local backend/.env before running:
# npm run test:recovery:mongo
#
# Never use the main development database or production database here.
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/blueguardian_test

# -------------------- Legacy Data Migration --------------------
# The migration script runs in dry-run mode by default.
#
# Only configure these after:
# 1. Taking and verifying a database backup.
# 2. Confirming all unowned legacy records belong to one owner.
# 3. Reviewing the dry-run results.
#
# Both owner IDs must match before applying the migration.
# The confirmation value must exactly match the same owner ID.
#
# BLUEGUARDIAN_LEGACY_OWNER_ID=
# BLUEGUARDIAN_CONFIRM_LEGACY_OWNER_BACKFILL=

# ============================================================
# SECURITY NOTES
# ============================================================
# - Never commit backend/.env.
# - Never share real tokens or MongoDB credentials.
# - Production protected APIs remain disabled until proper
#   OIDC/JWKS identity verification is implemented.
# - CORS is not authentication.
# - Never run destructive integration tests against production.
