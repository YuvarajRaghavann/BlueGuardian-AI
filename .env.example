# Optional production web sign-in configuration. The identity provider must issue
# a signed access token whose "iss" and "aud" match backend OIDC settings.
VITE_API_BASE=https://your-backend.example/api
VITE_OIDC_ISSUER=https://your-identity-provider.example/
VITE_OIDC_CLIENT_ID=your-public-spa-client-id
VITE_OIDC_AUDIENCE=https://your-backend.example/
VITE_OIDC_REDIRECT_URI=https://your-frontend.example/recovery
VITE_OIDC_SCOPES=openid profile email
