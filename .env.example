# Optional local frontend settings.
# The Vite proxy works by default at /api. Uncomment and set your own values only when needed.
# VITE_API_BASE=http://localhost:4000/api

# Configure all OIDC values only when a real provider/client has been created.
# The public SPA must allow Authorization Code + PKCE (S256) and the exact callback URI.
# VITE_OIDC_ISSUER=https://your-identity-provider.example/
# VITE_OIDC_CLIENT_ID=your-public-spa-client-id
# VITE_OIDC_AUDIENCE=https://your-backend.example/
# VITE_OIDC_REDIRECT_URI=https://your-frontend.example/recovery
# VITE_OIDC_SCOPES=openid profile email
